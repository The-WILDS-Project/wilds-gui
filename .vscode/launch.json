{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wilds-gui (Django :8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8000", "--noreload"],
      "python": "${workspaceFolder}/../.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "env": { "WILDS_CONTROL_URL": "http://localhost:8001" },
      "django": true,
      "justMyCode": true
    }
  ]
}
